# Adresse des DeskOS-Backends (LAN-IP, nicht localhost, wenn der Agent auf
# einem anderen Rechner läuft).
BACKEND_URL=http://localhost:4001
AGENT_NAME=remote-pc-1
POLL_INTERVAL=1000
# Optional: Gerätekategorie erzwingen (remote | RaspberryPi | Arduino).
# Ohne Angabe erkennt der Agent einen Raspberry Pi automatisch.
#AGENT_TYPE=remote
